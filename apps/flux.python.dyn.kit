[package]
title = "FLUX Dynamic Benchmark"
description = "Headless Isaac Lab rendering with dynamic people support"
version = "1.0.0"
keywords = ["experience", "isaaclab", "python", "camera", "people"]

[dependencies]
"isaaclab.python.headless" = {}
"omni.replicator.core" = {}
"omni.kit.material.library" = {}
"omni.kit.viewport.rtx" = {}
"omni.anim.people" = {}

[settings.isaaclab]
cameras_enabled = true
